# Postgres connection string (Render/Railway/local)
DATABASE_URL="postgresql://user:password@localhost:5432/ticket_booking?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Seat hold TTL, in seconds (how long a held seat stays reserved before auto-release)
SEAT_HOLD_TTL_SECONDS=600

# Waitlist offer window, in seconds (how long a waitlisted customer has to complete booking)
WAITLIST_OFFER_TTL_SECONDS=1800

# How often the background sweeper checks for expired holds/offers, in seconds
SWEEPER_INTERVAL_SECONDS=30

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Email (SMTP). For local/dev testing without real credentials, leave EMAIL_MODE=ethereal
# and the app will auto-create a throwaway Ethereal inbox and log a preview URL per email.
# For production, set EMAIL_MODE=smtp and fill in the fields below (Gmail App Password,
# SendGrid, Mailgun free tier, etc. all work).
EMAIL_MODE="ethereal"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Ticket Booking <no-reply@ticketbooking.dev>"

# Base URL the frontend is served from, used to build links inside emails
FRONTEND_URL="http://localhost:5173"
